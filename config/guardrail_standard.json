    "topicsConfig": [
      {
        "name": "InvestmentAdvice",
        "type": "DENY",
        "definition": "Any request for or provision of personalized investment, securities, fund, or retirement financial planning advice, including recommendations on what to buy, sell, or hold, and expected returns. 任何关于个人投资理财、证券基金买卖、退休财务规划的具体建议或收益承诺。",
        "examples": [
          "How should I invest for my retirement? I want $5,000 a month.",
